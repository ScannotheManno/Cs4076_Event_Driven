<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" 
    fx:controller="org.openjfx.servergui.ServerGUIController"
    style="-fx-background-color: #FFFFFF;">
    
    <!-- Green header bar -->
    <Rectangle fill="GREEN" width="10000" height="100"
           AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" />

    <!-- Main content area -->
    <VBox spacing="20" alignment="CENTER" 
          AnchorPane.topAnchor="20" AnchorPane.bottomAnchor="0" 
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" 
          style="-fx-background-color: #FFFFFF; -fx-padding: 20;">
        
        <!-- Server title -->
        <Label text="Timetable Server Console" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
        
        <!-- Server log section -->
        <VBox spacing="5" style="-fx-border-color: #DDDDDD; -fx-border-radius: 5; -fx-padding: 10;">
            <Label text="Server Log:" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <TextArea fx:id="logArea" editable="false" wrapText="true" 
                      prefWidth="600" prefHeight="300"
                      style="-fx-control-inner-background: #F8F8F8; -fx-font-family: monospace;"/>
        </VBox>
        
        <!-- Client connections section -->
        <VBox spacing="5" style="-fx-border-color: #DDDDDD; -fx-border-radius: 5; -fx-padding: 10;">
            <Label text="Connected Clients:" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <ListView fx:id="clientListView" prefWidth="600" prefHeight="150"
                      style="-fx-control-inner-background: #F8F8F8;"/>
        </VBox>
        
        <!-- Control buttons -->
        <HBox spacing="20" alignment="CENTER">
            <Button fx:id="startServerBtn" text="Start Server" onAction="#handleStartServer" 
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;"/>
            <Button fx:id="stopServerBtn" text="Stop Server" onAction="#handleStopServer"
                    style="-fx-background-color: #F44336; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;"/>
        </HBox>
    </VBox>
</AnchorPane>