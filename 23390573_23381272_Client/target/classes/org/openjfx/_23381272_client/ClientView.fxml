<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.openjfx._23381272_client.ClientController">
    <!-- Main Menu -->
    <center>
        <VBox alignment="CENTER" spacing="15">
            <Button fx:id="addLectureButton" text="Add a Lecture" maxWidth="200" onAction="#handleAddLecture"  />
            <Button fx:id="removeLectureButton" text="Remove a Lecture" maxWidth="200" />
            <Button fx:id="viewScheduleButton" text="View Schedule" maxWidth="200" />
            <Button fx:id="otherButton" text="Other" maxWidth="200" onAction="#handleOther" />
            <Button fx:id="quitButton" text="Quit" maxWidth="200" onAction="#handleQuit" />
        </VBox>
    </center>
</BorderPane>
