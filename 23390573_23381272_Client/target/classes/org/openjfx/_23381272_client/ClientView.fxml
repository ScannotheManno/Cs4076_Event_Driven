<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.openjfx._23381272_client.ClientController" style="-fx-background-color: #FFFFFF;" prefWidth="800" prefHeight="600">
    <top>
        <Rectangle width="800" height="20" fill="GREEN" />
    </top>

    <center>
        <VBox alignment="CENTER" spacing="15" style="-fx-background-color: #FFFFFF;">
            <ImageView fx:id="logo" fitWidth="200" fitHeight="100">
                <image>
                    <Image url="@Images/ul_logo.jpg" />
                </image>
            </ImageView>

            <HBox alignment="CENTER" spacing="15">
                <VBox alignment="CENTER" spacing="10">
                    <ImageView fx:id="addLectureImage" fitWidth="100" fitHeight="100">
                        <image>
                            <Image url="@Images/add_lecture_image.jpg" />
                        </image>
                    </ImageView>
                    <Button fx:id="addLectureButton" text="Add a Lecture" maxWidth="200" onAction="#handleAddLecture" />
                </VBox>

                <VBox alignment="CENTER" spacing="10">
                    <ImageView fx:id="removeLectureImage" fitWidth="100" fitHeight="100">
                        <image>
                            <Image url="@Images/remove_lecture_image.jpg" />
                        </image>
                    </ImageView>
                    <Button fx:id="removeLectureButton" text="Remove a Lecture" maxWidth="200" onAction="#handleRemoveLecture" />
                </VBox>

                <VBox alignment="CENTER" spacing="10">
                    <ImageView fx:id="viewScheduleImage" fitWidth="100" fitHeight="100">
                        <image>
                            <Image url="@Images/view_schedule_image.jpg" />
                        </image>
                    </ImageView>
                    <Button fx:id="viewScheduleButton" text="View Schedule" maxWidth="200" onAction="#handleViewSchedule" />
                </VBox>

                <VBox alignment="CENTER" spacing="10">
                    <ImageView fx:id="otherImage" fitWidth="100" fitHeight="100">
                        <image>
                            <Image url="@Images/other_image.jpg" />
                        </image>
                    </ImageView>
                    <Button fx:id="otherButton" text="Other" maxWidth="200" onAction="#handleOther" />
                </VBox>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 0 0 50 0;">
            <Button fx:id="quitButton" text="Quit" maxWidth="200" onAction="#handleQuit" />
        </VBox>
    </bottom>
</BorderPane>