<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.image.ImageView?>


<AnchorPane xmlns:fx="http://javafx.com/fxml/1" 
    fx:controller="org.openjfx._23381272_client.LoginController"
    style="-fx-background-color: #FFFFFF;">
    
    <Rectangle fill="GREEN" width="10000" height="20"
           AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" />

    <VBox spacing="10" alignment="CENTER" AnchorPane.topAnchor="20" AnchorPane.bottomAnchor="0" 
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" 
          style="-fx-background-color: #FFFFFF; -fx-padding: 20;">
        
        <ImageView fx:id="logo" fitWidth="200" fitHeight="100" style="-fx-background-color: #FFFFFF;"/>


        <Label text="Login" style="-fx-font-size: 20; -fx-font-weight: bold;"/>

        <TextField fx:id="usernameField" promptText="Username" maxWidth="200"
        style="-fx-background-color: white; -fx-text-fill: black; -fx-border-color: black; -fx-border-radius: 5; -fx-padding: 5;"/>
        <PasswordField fx:id="passwordField" promptText="Password" maxWidth="200"
        style="-fx-background-color: white; -fx-text-fill: black; -fx-border-color: black; -fx-border-radius: 5; -fx-padding: 5;"/>
        
        <HBox spacing="20" alignment="CENTER">
            <VBox alignment="CENTER" spacing="5" onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit">
                <Button fx:id="loginButton" text="Login" onAction="#handleLogin" prefWidth="150"
                style="-fx-background-color: green; -fx-text-fill: white; -fx-border-color: black; -fx-border-radius: 5; -fx-padding: 10; -fx-font-size: 14px;"/>
            </VBox>
            <VBox alignment="CENTER" spacing="5" onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit">
                <Button fx:id="quitButton" text="Quit" onAction="#handleQuit" prefWidth="150"
                        style="-fx-background-color: green; -fx-text-fill: white; -fx-border-color: black; -fx-border-radius: 5; -fx-padding: 10; -fx-font-size: 14px;"/>
            </VBox>
        </HBox>
    </VBox>
</AnchorPane>
