<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.openjfx._23381272_client.AddLectureController">
    <VBox alignment="CENTER" spacing="10">
        <Label text="Start Date:" />
        <DatePicker fx:id="startDatePicker" />
        <Label text="End Date:" />
        <DatePicker fx:id="endDatePicker" />
        <Label text="Start Time:" />
        <ComboBox fx:id="timeStartComboBox" />
        <Label text="End Time:" />
        <ComboBox fx:id="timeEndComboBox" />
        <Label text="Room:" />
        <ComboBox fx:id="roomsComboBox" />
        <Label text="Class Type:" />
        <ComboBox fx:id="typeComboBox" />
        <Label text="Module Name:" />
        <TextField fx:id="moduleNameField" promptText="Enter Module name" />
        <Label text="Module ID:" />
        <TextField fx:id="moduleIDField" promptText="Enter Module ID" />
        <Button fx:id="submitLectureButton" text="Submit" />
    </VBox>
</AnchorPane>
