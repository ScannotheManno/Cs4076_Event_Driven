<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.openjfx._23381272_client.ClientController" style="-fx-background-color: #FFFFFF;" prefWidth="800" prefHeight="600">
    <top>
        <Rectangle width="800" height="20" fill="GREEN" />
    </top>

    <center>
        <VBox alignment="CENTER" spacing="15" style="-fx-background-color: #FFFFFF;">
            <ImageView fx:id="logo" fitWidth="200" fitHeight="100">
                <image>
                    <Image url="@Images/ul_logo.jpg" />
                </image>
            </ImageView>

            <HBox alignment="CENTER" spacing="15">
                <Button fx:id="addLectureButton" onAction="#handleAddLecture" style="-fx-background-color: transparent; -fx-border-color: #000000; -fx-border-width: 2; -fx-border-radius: 5; -fx-padding: 10;">
                    <graphic>
                        <VBox alignment="CENTER" spacing="5">
                            <ImageView fx:id="addLectureImage" fitWidth="100" fitHeight="100">
                                <image>
                                    <Image url="@Images/add_lecture_image.jpg" />
                                </image>
                            </ImageView>
                            <Label text="Add a Lecture" style="-fx-font-weight: bold; -fx-font-size: 14;" />
                        </VBox>
                    </graphic>
                </Button>

                <Button fx:id="removeLectureButton" onAction="#handleRemoveLecture" style="-fx-background-color: transparent; -fx-border-color: #000000; -fx-border-width: 2; -fx-border-radius: 5; -fx-padding: 10;">
                    <graphic>
                        <VBox alignment="CENTER" spacing="5">
                            <ImageView fx:id="removeLectureImage" fitWidth="100" fitHeight="100">
                                <image>
                                    <Image url="@Images/remove_lecture_image.jpg" />
                                </image>
                            </ImageView>
                            <Label text="Remove a Lecture" style="-fx-font-weight: bold; -fx-font-size: 14;" />
                        </VBox>
                    </graphic>
                </Button>

                <Button fx:id="viewScheduleButton" onAction="#handleViewSchedule" style="-fx-background-color: transparent; -fx-border-color: #000000; -fx-border-width: 2; -fx-border-radius: 5; -fx-padding: 10;">
                    <graphic>
                        <VBox alignment="CENTER" spacing="5">
                            <ImageView fx:id="viewScheduleImage" fitWidth="100" fitHeight="100">
                                <image>
                                    <Image url="@Images/view_schedule_image.jpg" />
                                </image>
                            </ImageView>
                            <Label text="View Schedule" style="-fx-font-weight: bold; -fx-font-size: 14;" />
                        </VBox>
                    </graphic>
                </Button>

                <Button fx:id="otherButton" onAction="#handleOther" style="-fx-background-color: transparent; -fx-border-color: #000000; -fx-border-width: 2; -fx-border-radius: 5; -fx-padding: 10;">
                    <graphic>
                        <VBox alignment="CENTER" spacing="5">
                            <ImageView fx:id="otherImage" fitWidth="100" fitHeight="100">
                                <image>
                                    <Image url="@Images/other_image.jpg" />
                                </image>
                            </ImageView>
                            <Label text="Other" style="-fx-font-weight: bold; -fx-font-size: 14;" />
                        </VBox>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 0 0 50 0;">
            <Button fx:id="quitButton" text="Quit" maxWidth="200" onAction="#handleQuit" style="-fx-font-weight: bold; -fx-font-size: 14; -fx-border-color: #000000; -fx-border-width: 1; -fx-border-radius: 3; -fx-padding: 5;" />
        </VBox>
    </bottom>
</BorderPane>