<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.ImageView?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="org.openjfx._23381272_client.AddLectureController">
    
    <VBox alignment="CENTER" spacing="20" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" 
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        
        <!-- Logo at the top -->
        <ImageView fx:id="logo" fitWidth="200" fitHeight="100"/>

        <!-- HBox for two-column layout -->
        <HBox alignment="CENTER" spacing="40">
            
            <!-- Left Side Inputs -->
            <VBox alignment="CENTER" spacing="10">
                <Label text="Module Name:" />
                <TextField fx:id="moduleNameField" promptText="Enter Module Name" maxWidth="200" />
                
                <Label text="Module ID:" />
                <TextField fx:id="moduleIDField" promptText="Enter Module ID" maxWidth="200" />
                
                <Label text="Day:" />
                <ComboBox fx:id="dayComboBox" maxWidth="200" />
                
                <Label text="Start Time:" />
                <ComboBox fx:id="timeStartComboBox" maxWidth="200" />
            </VBox>

            <!-- Right Side Inputs -->
            <VBox alignment="CENTER" spacing="10">
                <Label text="Duration:" />
                <Spinner fx:id="durationSpinner" maxWidth="100" />
                
                <Label text="Room:" />
                <ComboBox fx:id="roomsComboBox" maxWidth="200" />
                
                <Label text="Class Type:" />
                <ComboBox fx:id="typeComboBox" maxWidth="200" />
            </VBox>

        </HBox>

        <!-- Submit Button Below -->
        <Button fx:id="submitLectureButton" text="Submit" maxWidth="100" onAction="#handleSubmitButton" />
    
    </VBox>

</AnchorPane>
