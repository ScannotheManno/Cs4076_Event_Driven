<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.openjfx._23381272_client.OtherController">
    <VBox alignment="CENTER" spacing="10" layoutX="50" layoutY="50">
        <Label text="Make a Request:" />
        <ComboBox fx:id="dropdown" promptText="Choose a request" />
        <TextField fx:id="otherTextField" promptText="Enter your request" maxWidth="200" visible="false" />
        <Button fx:id="submitButton" text="Submit" />
    </VBox>
</AnchorPane>
