<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" alignment="CENTER" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.openjfx._23381272_client.RemoveLectureController"
      style="-fx-background-color: #FFFFFF; -fx-padding: 20;">
    
    <Label text="Remove a Lecture" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: black;"/>

    <ComboBox fx:id="lectureComboBox" prefWidth="250" style="-fx-background-color: white; -fx-text-fill: black; -fx-border-color: black;"/>
    
    <Button fx:id="removeLectureButton" text="Remove Lecture" onAction="#handleRemoveLecture" prefWidth="150" 
            style="-fx-background-color: white; -fx-text-fill: black; -fx-border-color: black;"/>

</VBox>