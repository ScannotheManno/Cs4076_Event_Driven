<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>


<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.openjfx._23381272_client.TimeTablePopUpController"
            prefWidth="1000" prefHeight="700" style="-fx-background-color: white;">
    
    <Rectangle fill="GREEN" width="10000" height="20"
           AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" />
           
    <HBox alignment="CENTER" spacing="40" style="-fx-background-color: #FFFFFF;"
          AnchorPane.topAnchor="80" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <VBox alignment="CENTER" onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit">
            <Button fx:id="groupTimetable" text="Module Timetable" maxWidth="175" onAction="#handleGroupTimetable" 
                    style="-fx-background-color: green; -fx-text-fill: white; -fx-border-color: black; -fx-border-radius: 5; -fx-padding: 10; -fx-font-size: 14px;"/>
        </VBox>
        <VBox alignment="CENTER" onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit">
            <Button fx:id="personalTimefable" text="Personal Timetable" maxWidth="175" onAction="#handlePersonalTimetable" 
                    style="-fx-background-color: green; -fx-text-fill: white; -fx-border-color: black; -fx-border-radius: 5; -fx-padding: 10; -fx-font-size: 14px;"/>
        </VBox>
    </HBox>    

    

</AnchorPane>
