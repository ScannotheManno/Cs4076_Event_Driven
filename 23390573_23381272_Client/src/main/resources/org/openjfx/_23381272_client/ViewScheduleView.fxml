<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.openjfx._23381272_client.ViewScheduleController"
            prefWidth="1000" prefHeight="700" style="-fx-background-color: white;">
    
    <VBox alignment="CENTER" spacing="20" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">
        <ImageView fx:id="logo" fitWidth="200" fitHeight="100"/>

        <GridPane fx:id="scheduleGrid"
                  hgap="5" vgap="5"
                  alignment="CENTER"
                  style="-fx-background-color: white; -fx-padding: 10;">
        </GridPane>

        <Button fx:id="backButton" text="Back" 
                style="-fx-background-color: green; -fx-text-fill: white; -fx-border-color: black; -fx-padding: 10; -fx-font-size: 14px;"
                onAction="#handleBackButton"/>
    </VBox>
</AnchorPane>