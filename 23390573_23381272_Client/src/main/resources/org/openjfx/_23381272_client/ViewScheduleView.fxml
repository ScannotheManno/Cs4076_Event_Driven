<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>


<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.openjfx._23381272_client.ViewScheduleController"
            prefWidth="1000" prefHeight="700" style="-fx-background-color: white;">
    <Rectangle fill="GREEN" width="900" height="20"
           AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" />


    <VBox alignment="CENTER" spacing="10" AnchorPane.topAnchor="80" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">

        <GridPane fx:id="scheduleGrid"
                  hgap="0" vgap="0"
                  alignment="CENTER"
                  style="-fx-background-color: white; -fx-padding: 10;">
        </GridPane>

        <Button fx:id="backButton" text="Back" 
                style="-fx-background-color: green; -fx-text-fill: white; -fx-border-color: black; -fx-padding: 10; -fx-font-size: 14px;"
                onAction="#handleBackButton"/>
    </VBox>

    <!-- This VBox will appear on top -->
    <VBox layoutX="375" layoutY="25" spacing="0">
        <ImageView fx:id="logo" fitWidth="125" fitHeight="60"/>
    </VBox>

</AnchorPane>
